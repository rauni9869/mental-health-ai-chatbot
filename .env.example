# Auth — generated locally by `pnpm setup:local`. Not an LLM key.
AUTH_SECRET=****

# --- Open-weight models (no OpenAI) ---
# Default: Ollama on this machine. No API key.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must match a name from `ollama list`. If unset, Steady uses any pulled model.
OLLAMA_CHAT_MODEL=llama3.1:latest
OLLAMA_REASONING_MODEL=llama3.1:latest
OLLAMA_SMALL_MODEL=llama3.1:latest
# OLLAMA_API_KEY=ollama

# Optional hosted open-weight path (Groq runs Llama / DeepSeek, not GPT).
# Get a free key at https://console.groq.com/keys and put it only in .env.local
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b
# GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Postgres used by docker compose from this repo
POSTGRES_URL=postgres://steady:steady@127.0.0.1:5432/steady

# Optional
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
