# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Open-weight models via Groq (default). Get a key: https://console.groq.com/keys
GROQ_API_KEY=****
# Optional Groq model overrides
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_REASONING_MODEL=deepseek-r1-distill-llama-70b
# GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Fully local alternative: run Ollama and set this instead of GROQ_API_KEY
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_REASONING_MODEL=llama3.1
# OLLAMA_SMALL_MODEL=llama3.1
# OLLAMA_API_KEY=ollama

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****

# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****
