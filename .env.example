# Auth — generated locally by `pnpm setup:local`. Not an LLM key.
AUTH_SECRET=****

# --- Open-weight models (no OpenAI) ---
# Recommended on a laptop: Groq-hosted Llama. The Mac does not run the model.
# Free key: https://console.groq.com/keys  (put it only in .env.local)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Local Ollama (only if the machine has enough RAM — llama3.1 is ~5GB and will freeze many Macs)
# USE_OLLAMA=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.1:latest
# OLLAMA_REASONING_MODEL=llama3.1:latest
# OLLAMA_SMALL_MODEL=llama3.1:latest
# OLLAMA_API_KEY=ollama

# Postgres used by docker compose from this repo
POSTGRES_URL=postgres://steady:steady@127.0.0.1:5432/steady

# Optional
# BLOB_READ_WRITE_TOKEN=
# REDIS_URL=
